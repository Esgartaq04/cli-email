<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ view.role_title }} · {{ view.sector }} — {{ view.run_date.isoformat() }}</title>
<style>
  :root {
    --bg: #f7f7f5;
    --surface: #ffffff;
    --border: #e2e1dc;
    --border-strong: #cfcdc6;
    --text: #1c1b19;
    --muted: #6b6963;
    --faint: #94918a;
    --accent: #2f5d50;
    --accent-soft: #e6efeb;
    --warn: #8a5a20;
    --warn-soft: #f6ecdd;
    --bad: #8c3434;
    --bad-soft: #f7e6e4;
    --quote-bar: #2f5d50;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #17181a;
      --surface: #1f2123;
      --border: #32353a;
      --border-strong: #44484e;
      --text: #ececea;
      --muted: #a2a49f;
      --faint: #7b7e7a;
      --accent: #7fc2ac;
      --accent-soft: #23322d;
      --warn: #d9ab6c;
      --warn-soft: #322a1d;
      --bad: #e08a80;
      --bad-soft: #33221f;
      --quote-bar: #7fc2ac;
    }
  }
  :root[data-theme="dark"] {
    --bg: #17181a; --surface: #1f2123; --border: #32353a; --border-strong: #44484e;
    --text: #ececea; --muted: #a2a49f; --faint: #7b7e7a; --accent: #7fc2ac;
    --accent-soft: #23322d; --warn: #d9ab6c; --warn-soft: #322a1d; --bad: #e08a80;
    --bad-soft: #33221f; --quote-bar: #7fc2ac;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: ui-sans-serif, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 15px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px 64px; }

  .sample-banner {
    background: var(--warn-soft); color: var(--warn);
    border-bottom: 1px solid var(--border);
    padding: 10px 16px; text-align: center;
    font-size: 13px; font-weight: 600; letter-spacing: .01em;
  }

  header.run { padding: 32px 0 20px; border-bottom: 1px solid var(--border); }
  h1 { font-size: 21px; margin: 0 0 6px; letter-spacing: -.01em; }
  .run-meta { color: var(--muted); font-size: 13.5px; }
  .run-meta span + span::before { content: "·"; margin: 0 8px; color: var(--faint); }

  h2.section {
    font-size: 12px; text-transform: uppercase; letter-spacing: .09em;
    color: var(--faint); font-weight: 600;
    margin: 40px 0 14px; padding-bottom: 6px; border-bottom: 1px solid var(--border);
  }

  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px; margin-bottom: 16px;
  }
  .card-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .co-name { font-size: 17px; font-weight: 650; letter-spacing: -.01em; }
  .co-domain { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .co-facts { color: var(--muted); font-size: 13px; margin-top: 4px; }
  .co-facts .src { color: var(--faint); }

  .claim {
    margin: 18px 0 4px; font-size: 16px; font-weight: 600; line-height: 1.4;
  }
  .summary { color: var(--muted); font-size: 13.5px; margin: 0 0 16px; }

  .ev { border-left: 3px solid var(--quote-bar); padding: 2px 0 2px 14px; margin: 14px 0; }
  .ev blockquote {
    margin: 0 0 6px; font-size: 15.5px; line-height: 1.5; color: var(--text);
  }
  .ev-meta { font-size: 12.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .badge {
    display: inline-block; padding: 2px 7px; border-radius: 4px;
    font-size: 11px; font-weight: 600; letter-spacing: .02em;
    background: var(--accent-soft); color: var(--accent); border: 1px solid transparent;
  }
  .badge.third { background: transparent; color: var(--muted); border-color: var(--border-strong); }
  .ev-meta a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .ev-meta a:hover { color: var(--text); }

  .contacts { margin-top: 20px; border-top: 1px solid var(--border); padding-top: 14px; }
  .contacts h3 { font-size: 11.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); margin: 0 0 10px; font-weight: 600; }
  .person { display: flex; flex-wrap: wrap; gap: 4px 10px; padding: 9px 0; border-bottom: 1px dashed var(--border); }
  .person:last-child { border-bottom: 0; }
  .p-main { flex: 1 1 260px; }
  .p-name { font-weight: 600; }
  .p-title { color: var(--muted); font-size: 13.5px; }
  .p-why { color: var(--faint); font-size: 12.5px; margin-top: 2px; }
  .p-mail { flex: 0 1 auto; font-family: var(--mono); font-size: 12.5px; }
  .p-mail.ok { color: var(--accent); }
  .p-mail.none { color: var(--faint); }
  .flag { font-size: 11px; font-weight: 600; color: var(--warn); background: var(--warn-soft); padding: 2px 6px; border-radius: 4px; }

  .fetchlog { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    font-family: var(--mono); font-size: 11.5px; padding: 3px 8px;
    border-radius: 4px; border: 1px solid var(--border-strong); color: var(--muted);
  }
  .chip.ok { border-color: transparent; background: var(--accent-soft); color: var(--accent); }
  .chip.err { border-color: transparent; background: var(--bad-soft); color: var(--bad); }
  .why-none { color: var(--muted); font-size: 13.5px; margin-top: 12px; }


  .findings { margin-top: 18px; border-top: 1px solid var(--border); padding-top: 14px; }
  .findings h3 { font-size: 11.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); margin: 0 0 10px; font-weight: 600; }
  details.theme { border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; margin-bottom: 8px; }
  details.theme summary { cursor: pointer; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
  .theme-name { font-weight: 600; }
  .theme-facts { color: var(--muted); font-size: 12.5px; }
  .theme-short { color: var(--warn); font-size: 12.5px; }
  details.theme .ev { margin: 12px 0 4px; }
  .pages { list-style: none; margin: 0; padding: 0; font-size: 12.5px; }
  .pages li { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; padding: 3px 0; color: var(--muted); }
  .pages .none { color: var(--faint); }
  .pages a { color: var(--muted); word-break: break-all; }

  .co-facts > span + span::before { content: "·"; margin: 0 8px; color: var(--faint); }
  .stage {
    display: inline-block; padding: 2px 8px; border-radius: 999px;
    font-size: 11.5px; font-weight: 600; letter-spacing: .02em;
    border: 1px solid var(--border-strong); color: var(--muted);
  }
  .stage-growth, .stage-expansion { background: var(--accent-soft); color: var(--accent); border-color: transparent; }
  .stage-maturity { background: var(--warn-soft); color: var(--warn); border-color: transparent; }
  .stage-why { color: var(--faint); font-size: 12.5px; margin-top: 2px; }

  .hn-post { margin-top: 6px; font-size: 13px; }
  .hn-post a { color: var(--muted); }
  .postings { list-style: none; margin: 12px 0 0; padding: 0; font-size: 13.5px; }
  .postings li { padding: 2px 0; }
  .postings a { color: var(--text); }
  .work-mode {
    font-family: var(--mono); font-size: 11px; padding: 1px 6px; margin-left: 8px;
    border-radius: 4px; border: 1px solid var(--border-strong); color: var(--muted);
  }

  .building, .hooks { margin-top: 18px; border-top: 1px solid var(--border); padding-top: 14px; }
  .building h3, .hooks h3 { font-size: 11.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); margin: 0 0 10px; font-weight: 600; }
  .finding + .finding { margin-top: 22px; }
  .finding-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .finding .claim { margin-top: 6px; }
  .badge.corroborated { background: var(--accent); color: var(--surface); }
  .hooks ul { list-style: none; margin: 0; padding: 0; font-size: 13px; }
  .hooks li { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; padding: 3px 0; color: var(--muted); }
  .hooks a { color: var(--text); word-break: break-all; }

  .p-links { flex: 0 1 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .p-li { font-size: 12.5px; color: var(--accent); }
  .p-li.search { color: var(--muted); }

  .excluded { list-style: none; margin: 0; padding: 0; font-size: 13.5px; }
  .excluded li { padding: 6px 0; border-bottom: 1px dashed var(--border); color: var(--muted); }
  .excluded .ex-name { color: var(--text); font-weight: 600; margin-right: 8px; }
  .empty { color: var(--faint); font-size: 13.5px; }

  footer.diag {
    margin-top: 44px; padding-top: 18px; border-top: 1px solid var(--border);
    font-size: 13px; color: var(--muted);
  }
  footer.diag h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .09em; color: var(--faint); margin: 0 0 12px; font-weight: 600; }
  .diag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px 20px; }
  .diag-item .k { font-size: 11.5px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; }
  .diag-item .v { font-family: var(--mono); font-size: 14px; color: var(--text); }
  .diag-err { margin-top: 14px; font-family: var(--mono); font-size: 12.5px; color: var(--bad); }
</style>
</head>
<body>

<div class="wrap">

<header class="run">
  <h1>{{ view.role_title }} · {{ view.sector }}</h1>
  <div class="run-meta">
    <span>{{ view.run_date.strftime('%d %b %Y') }}</span>
    <span>≤ {{ '{:,}'.format(view.headcount_max) }} employees</span>
    <span>{{ view.target_stage|length + view.other_stages|length + view.no_findings|length }} companies researched</span>
    <span>{{ view.target_stage|length }} growth &amp; expansion</span>
    <span>{{ view.other_stages|length }} other stages</span>
    <span>{{ view.no_findings|length }} no building evidence</span>
    <span>{{ view.excluded|length }} excluded</span>
  </div>
</header>

{% macro evidence_block(e) %}
  <div class="ev">
    <blockquote>{{ e.quote }}</blockquote>
    <div class="ev-meta">
      <span class="badge{% if e.source_class == 'news' %} third{% endif %}">
        {{ e.source_class.replace('_', ' ') }}</span>
      <span>{% if e.published_at %}
              {% if e.source_class in current_state_classes %}
                current as of {{ e.published_at.strftime('%d %b') }}
              {% else %}{{ e.published_at.strftime('%d %b %Y') }}{% endif %}
            {% else %}undated{% endif %}</span>
      <a href="{{ e.url }}">{{ e.url }}</a>
    </div>
  </div>
{% endmacro %}

{% macro contacts_block(company) %}
  {% if not company.domain_confirmed %}
  <div class="contacts">
    <h3>Contacts</h3>
    <p class="why-none">Domain unconfirmed — no surface fetch reached
      {{ company.domain }}, so contact lookup was skipped rather than risk
      enriching against the wrong company.</p>
  </div>
  {% elif company.contacts %}
  <div class="contacts">
    <h3>Contacts</h3>
    {% for c in company.contacts %}
    <div class="person">
      <div class="p-main">
        <div class="p-name">{{ c.full_name }}</div>
        <div class="p-title">{{ c.title }}</div>
        <div class="p-why">{{ c.why }}</div>
      </div>
      <div class="p-links">
        {% if c.email_status == 'verified' and c.email %}
          <div class="p-mail ok">{{ c.email }}</div>
        {% else %}
          <div class="p-mail none">no verified address</div>
        {% endif %}
        {# A found profile is linked as itself; without one, a search is
           offered and labelled as a search, never as the person's profile. #}
        {% if c.profile_url %}
          <a class="p-li" href="{{ c.profile_url }}">LinkedIn</a>
        {% elif c.linkedin_search %}
          <a class="p-li search" href="{{ c.linkedin_search }}">Search LinkedIn</a>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
{% endmacro %}

{% macro findings_block(company) %}
  {% if company.themes %}
  <div class="findings">
    <h3>What was found</h3>
    {% for t in company.themes %}
    <details class="theme">
      <summary>
        <span class="theme-name">{{ t.theme }}</span>
        <span class="theme-facts">{{ t.evidence|length }} quote{{ '' if t.evidence|length == 1 else 's' }}
          · {{ t.source_labels|join(', ') }}</span>
        <span class="theme-short">{{ t.independent_sources }} of {{ view.min_independent_sources }}
          independent sources — {{ reason_text(t.reason) }}</span>
      </summary>
      {% for e in t.evidence %}{{ evidence_block(e) }}{% endfor %}
    </details>
    {% endfor %}
  </div>
  {% endif %}
  {% if company.sources_read %}
  <div class="findings">
    <h3>Pages read</h3>
    <ul class="pages">
      {% for src in company.sources_read %}
      <li>
        <span class="badge">{{ src.source_class.replace('_', ' ') }}</span>
        <span class="{% if not src.claims %}none{% endif %}">
          {% if src.claims %}{{ src.claims }} claim{{ '' if src.claims == 1 else 's' }}{% else %}no claims{% endif %}</span>
        <span>{% if src.published_at %}{{ src.published_at.strftime('%d %b %Y') }}{% else %}undated{% endif %}</span>
        <a href="{{ src.url }}">{{ src.url }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
{% endmacro %}

{% macro card(company) %}
<article class="card">
  <div class="card-head">
    <span class="co-name">{{ company.name }}</span>
    <span class="co-domain">{{ company.domain }}</span>
    <span class="stage stage-{{ company.stage }}">{{ company.stage_label }}</span>
  </div>
  {% if company.stage_reasons %}
  <div class="stage-why">{{ company.stage_reasons|join(' · ') }}</div>
  {% endif %}
  <div class="co-facts">
    <span>{% if company.headcount is not none %}~{{ company.headcount }} employees
        <span class="src">({{ company.headcount_source }})</span>
      {% elif company.headcount_band %}{{ company.headcount_band }} employees
      {% else %}headcount unknown{% endif %}</span>
    {% if company.founded_year %}<span>founded {{ company.founded_year }}</span>{% endif %}
    {% if company.latest_round %}<span>latest round {{ company.latest_round }}</span>{% endif %}
  </div>
  {% if company.hn_post %}
  <div class="hn-post">{% if company.hn_post[1] is http_url %}<a href="{{ company.hn_post[1] }}">{{ company.hn_post[0] }}</a>{% else %}<span>{{ company.hn_post[0] }}</span>{% endif %}</div>
  {% endif %}

  {% if company.postings %}
  <ul class="postings">
    {% for p in company.postings %}
    <li>{% if p.url is http_url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}<span>{{ p.title }}</span>{% endif %}<span class="work-mode">{{ p.work_mode }}</span></li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if company.findings %}
  <div class="building">
    <h3>What they're building</h3>
    {% for f in company.findings %}
    <div class="finding">
      <div class="finding-head">
        <span class="theme-name">{{ f.theme }}</span>
        {% if f.corroborated %}<span class="badge corroborated">corroborated</span>{% endif %}
      </div>
      <p class="claim">{{ f.claim }}</p>
      <p class="summary">{{ f.summary }}</p>
      {% for e in f.evidence %}{{ evidence_block(e) }}{% endfor %}
    </div>
    {% endfor %}
  </div>
  {% elif company.reason == 'research_failed' %}
  <p class="why-none"><strong>Research failed:</strong>
    {{ reason_text(company.reason) }}
    ({{ company.reason }}){% if company.error %} — {{ company.error }}{% endif %}.</p>
  {{ findings_block(company) }}
  {% else %}
  <p class="why-none"><strong>Gate failed:</strong>
    {{ reason_text(company.reason) }}
    ({{ company.reason }}).</p>
  {{ findings_block(company) }}
  {% endif %}

  {% if company.hooks %}
  <div class="hooks">
    <h3>Hooks for a build</h3>
    <ul>
      {% for h in company.hooks %}
      <li>
        <span class="badge">{{ h.kind }}</span>
        {% if h.url is http_url %}<a href="{{ h.url }}">{{ h.label }}</a>{% else %}<span>{{ h.label }}</span>{% endif %}
        {% if h.when %}<span>{% if h.kind == 'repo' %}pushed {% endif %}{{ h.when.strftime('%d %b %Y') }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {{ contacts_block(company) }}

  {% if company.fetch_log %}
  <div class="fetchlog">
    {% for source_class, outcome, status in company.fetch_log %}
    <span class="chip {% if outcome == 'ok' %}ok{% else %}err{% endif %}">
      {{ source_class.replace('_', ' ') }} · {{ outcome }}{% if status %} {{ status }}{% endif %}
    </span>
    {% endfor %}
  </div>
  {% endif %}
</article>
{% endmacro %}

<section id="target-stage">
<h2 class="section">Growth &amp; Expansion</h2>
{% for company in view.target_stage %}{{ card(company) }}
{% else %}<p class="empty">No growth or expansion company showed building evidence.</p>
{% endfor %}
</section>

<section id="other-stages">
<h2 class="section">Other stages</h2>
{% for company in view.other_stages %}{{ card(company) }}
{% else %}<p class="empty">None.</p>
{% endfor %}
</section>

<section id="no-findings">
<h2 class="section">No building evidence</h2>
{% for company in view.no_findings %}{{ card(company) }}
{% else %}<p class="empty">None.</p>
{% endfor %}
</section>

<section id="excluded">
<h2 class="section">Excluded</h2>
{% if view.excluded %}
<ul class="excluded">
  {% for e in view.excluded %}
  <li><span class="ex-name">{{ e.name }}</span><span class="co-domain">{{ e.domain }}</span>
    — {{ reason_text(e.reason) }}</li>
  {% endfor %}
</ul>
{% else %}<p class="empty">None.</p>
{% endif %}
</section>

<footer class="diag" id="diagnostics">
  <h2>Run diagnostics</h2>
  <div class="diag-grid">
    {% for key, value in view.diagnostics.items() %}
    <div class="diag-item"><div class="k">{{ key }}</div><div class="v">{{ value }}</div></div>
    {% endfor %}
  </div>
  {% if view.errors %}
  <div class="diag-err">
    {% for e in view.errors %}<div>{{ e }}</div>{% endfor %}
  </div>
  {% endif %}
</footer>

</div>
</body>
</html>
