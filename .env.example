# Copy this file to .env and fill in the keys you need. .env is never committed.

# Needed by `outreach jobs` and `outreach companies` -- the only key a company run needs.
# Create one at https://hunter.io/api-keys (the free plan includes 50 credits a month).
HUNTER_API_KEY=

# Needed only by `outreach jobs`, which asks the AI for similar job titles and to read
# "Who is hiring?" posts the rules can't. `outreach companies` never uses it.
ANTHROPIC_API_KEY=

# Optional, and only `outreach jobs` uses it: added to the user agent of the web pages it
# fetches (job boards, Hacker News, a company's homepage), so a site owner who notices
# them can write to you. Without it `outreach jobs` still runs, but prints a warning.
OUTREACH_CONTACT_EMAIL=
